-- Função para executar script
local function ExecuteScript()
    if not selectedGame then
        StatusLabel.Text = "❌ Selecione um jogo primeiro!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        wait(2)
        StatusLabel.Text = "🔴 Aguardando..."
        StatusLabel.TextColor3 = Color3.fromRGB(200, 100, 100)
        return
    end
    
    if selectedGame == "brookhaven" then
        if PlaceID == BROOKHAVEN_ID then
            StatusLabel.Text = "⚡ Executando Brookhaven..."
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            ExecuteButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
            
            -- Script Brookhaven
            loadstring(game:HttpGet("https://encrypt-x.pages.dev/Scripts?Id=4538884947868"))("4538884947868")
            
            wait(2)
            StatusLabel.Text = "✅ Brookhaven executado!"
            ExecuteButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            wait(2)
            StatusLabel.Text = "🔴 Aguardando..."
            StatusLabel.TextColor3 = Color3.fromRGB(200, 100, 100)
        else
            StatusLabel.Text = "❌ Entre no Brookhaven RP!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
            wait(2)
            StatusLabel.Text = "🔴 Aguardando..."
            StatusLabel.TextColor3 = Color3.fromRGB(200, 100, 100)
        end
    elseif selectedGame == "mm2" then
        if PlaceID == MM2_ID then
            StatusLabel.Text = "⚡ Executando MM2..."
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            ExecuteButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
            
            -- Script MM2
            loadstring(game:HttpGet("https://encrypt-x.pages.dev/Scripts?Id=6705719160061"))("6705719160061")
            
            wait(2)
            StatusLabel.Text = "✅ MM2 executado!"
            ExecuteButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            wait(2)
            StatusLabel.Text = "🔴 Aguardando..."
            StatusLabel.TextColor3 = Color3.fromRGB(200, 100, 100)
        else
            StatusLabel.Text = "❌ Entre no Murder Mystery 2!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
            wait(2)
            StatusLabel.Text = "🔴 Aguardando..."
            StatusLabel.TextColor3 = Color3.fromRGB(200, 100, 100)
        end
    end
end

-- Conectar botão Execute
ExecuteButton.MouseButton1Click:Connect(ExecuteScript)

-- Sistema de arrastar
local dragging = false
local dragStart
local startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

MainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

game:GetService("RunService").RenderStepped:Connect(function()
    if dragging then
        local delta = game:GetService("UserInputService"):GetMouseLocation() - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
