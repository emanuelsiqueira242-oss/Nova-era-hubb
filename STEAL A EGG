local function ApplyProximityPromptSettings()
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            if CurrentConfig.PromptDistance then
                prompt.MaxActivationDistance = CurrentConfig.PromptDistance
            end
            if CurrentConfig.InstantPrompt then
                prompt.HoldDuration = 0
            end
        end
    end
end

workspace.DescendantAdded:Connect(function(descendant)
    if descendant:IsA("ProximityPrompt") then
        task.wait(0.1)
        if CurrentConfig.PromptDistance then descendant.MaxActivationDistance = CurrentConfig.PromptDistance end
        if CurrentConfig.InstantPrompt then descendant.HoldDuration = 0 end
    end
end)

