    ToggleTP.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
    ToggleTP.Text = "TP BASE OFF"
    ToggleTP.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleTP.Font = Enum.Font.GothamBold
    ToggleTP.TextSize = 12
    ToggleTP.BorderSizePixel = 0
    ToggleTP.Parent = MainFrame

    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(0, 5)
    ToggleCorner.Parent = ToggleTP

    local StopButton = Instance.new("TextButton")
    StopButton.Size = UDim2.new(0.45, 0, 0, 35)
    StopButton.Position = UDim2.new(0.525, 0, 0, 35)
    StopButton.BackgroundColor3 = Color3.fromRGB(200, 120, 0)
    StopButton.Text = "STOP"
    StopButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    StopButton.Font = Enum.Font.GothamBold
    StopButton.TextSize = 12
    StopButton.BorderSizePixel = 0
    StopButton.Parent = MainFrame

    local StopCorner = Instance.new("UICorner")
    StopCorner.CornerRadius = UDim.new(0, 5)
    StopCorner.Parent = StopButton

    ToggleTP.MouseButton1Click:Connect(function()
        TPBaseEnabled = not TPBaseEnabled
        CurrentConfig.TPBaseEnabled = TPBaseEnabled
        SaveSettings()

        if TPBaseEnabled then
            ToggleTP.Text = "TP BASE ON"
            ToggleTP.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
            StopTPBase = false
        else
            ToggleTP.Text = "TP BASE OFF"
            ToggleTP.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
            StopTPBase = true
            if CurrentTween then
                CurrentTween:Cancel()
                CurrentTween = nil
            end
        end
    end)

    StopButton.MouseButton1Click:Connect(function()
        StopReturnToBase()
    end)

    -- Sistema de arrastar
    local dragging = false
    local dragInput
    local dragStart
    local startPos

    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    TitleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

