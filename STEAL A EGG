local function LoadSettings()
    if readfile and isfile and isfile(CONFIG_FILE) then
        pcall(function()
            local loaded = HttpService:JSONDecode(readfile(CONFIG_FILE))
            for k, v in pairs(loaded) do
                CurrentConfig[k] = v
            end
        end)
    end
end

