local BasePosition = Vector3.new(542.45, 70.57, -367.75)
local TPBaseSpeed = 700  -- Velocidade do TP Base
local HoldingEgg = false
local LastEggTime = 0
local StopTPBase = false
local CurrentTween = nil

-- DETECÇÃO DE OVO VIA PROXIMITYPROMPT
local Keywords = {
    "egg",
    "ovo",
    "collect",
    "grab",
    "pickup",
    "steal"
}

local function IsEggPrompt(Prompt)
    local Text = string.lower(
        (Prompt.Name or "") ..
        " " ..
        (Prompt.ActionText or "") ..
        " " ..
        (Prompt.ObjectText or "")
    )

    for _, Word in ipairs(Keywords) do
        if string.find(Text, Word) then
            return true
        end
    end

    return false
end

local function RegisterPrompt(Prompt)
    if not Prompt:IsA("ProximityPrompt") then
        return
    end

    if not IsEggPrompt(Prompt) then
        return
    end

    Prompt.Triggered:Connect(function(Player)
        if Player ~= LocalPlayer then
            return
        end

        HoldingEgg = true
        LastEggTime = tick()
        StopTPBase = false

        print("[TP BASE] Possível ovo detectado.")
    end)
end

for _, Obj in ipairs(workspace:GetDescendants()) do
    RegisterPrompt(Obj)
end

workspace.DescendantAdded:Connect(RegisterPrompt)

-- FUNÇÃO DE RETORNO À BASE
local function ReturnToBase()
    local Character = LocalPlayer.Character
    local HRP = Character and Character:FindFirstChild("HumanoidRootPart")

    if not HRP then
        return
    end

    local Distance = (HRP.Position - BasePosition).Magnitude
    local Speed = TPBaseSpeed

    if CurrentTween then
        CurrentTween:Cancel()
    end

    CurrentTween = TweenService:Create(
        HRP,
        TweenInfo.new(Distance / Speed, Enum.EasingStyle.Linear),
        {
            CFrame = CFrame.new(BasePosition)
        }
    )

    CurrentTween:Play()
end

-- FUNÇÃO PARA PARAR O TP
local function StopReturnToBase()
    StopTPBase = true
    HoldingEgg = false
    
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    
    print("[TP BASE] TP parado manualmente.")
end

-- LOOP DO TP BASE
task.spawn(function()
    while task.wait(0.25) do
        if not TPBaseEnabled then
            continue
        end

        if StopTPBase then
            continue
        end

        if HoldingEgg then
            ReturnToBase()
            HoldingEgg = false
        end

        if tick() - LastEggTime > 10 then
            HoldingEgg = false
        end
    end
end)

