-- ============================================
-- ANTI BANANA
-- ============================================
protec:AddToggle({
    Name = "Anti Banana",
    Default = false,
    Callback = function(value)
        getgenv().AntiBanana = value
        if value then
            local Protected = {}
            local function Check(obj)
                if not getgenv().AntiBanana then
                    return
                end
                if not obj:IsA("BasePart") then
                    return
                end
                local name = obj.Name:lower()
                local parent = obj.Parent and obj.Parent.Name:lower() or ""
                if name:find("banana") or name:find("peel") or parent:find("banana") or parent:find("peel") then
                    if not Protected[obj] then
                        Protected[obj] = true
                        pcall(function()
                            obj.CanTouch = false
                            obj.CanQuery = false
                        end)
                    end
                end
            end
            for _, v in ipairs(workspace:GetDescendants()) do
                Check(v)
            end
            workspace.DescendantAdded:Connect(Check)
        end
    end
})

