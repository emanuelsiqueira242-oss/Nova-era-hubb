                if v.Name == "Bomb" then
                    table.insert(allBombs, v)
                end
            end
            
            local bombCount = #allBombs
            
            if bombCount == 0 then
                StatusLabel.Text = "Sem bombas para lancar!"
                isFiring = false
                task.wait(1.5)
                StatusLabel.Text = "Pronto"
                return
            end
            
            StatusLabel.Text = "LANCANDO " .. bombCount .. " BOMBAS"
            
            local mouse = player:GetMouse()
            local targetPosition = mouse.Hit
            
            local char = player.Character
            local originalPos = nil
            if char and char:FindFirstChild("HumanoidRootPart") then
                originalPos = char.HumanoidRootPart.CFrame
                char.HumanoidRootPart.CFrame = targetPosition
                task.wait(0.1)
            end
            
            for i, bomb in pairs(allBombs) do
                if bomb.Parent ~= player.Character then
                    bomb.Parent = player.Character
                end
                
                local activated = false
                
                if bomb:FindFirstChild("RemoteEvent") then
                    pcall(function()
                        bomb.RemoteEvent:FireServer("PlaceBomb")
                        activated = true
                    end)
                end
                
                if not activated then
                    pcall(function()
                        bomb:Activate()
                        activated = true
                    end)
                end
                
